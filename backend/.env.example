# Copy to .env (repo root or backend/) and fill in. NEVER commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require   # Neon connection string
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-service.onrender.com                      # used inside report QR codes
CORS_ORIGINS=*                                                         # or: https://your-frontend.app,http://localhost:5173
SEED_SAMPLE_ON_STARTUP=true
DEMO_PASSWORD=Demo@1234
